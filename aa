#!/bin/bash
# Auto Applicator command-line wrapper:  ./aa --dry-run | --live | --setup | --doctor | --help
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$HOME/Library/Application Support/AutoApplicator/tools/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v uv >/dev/null 2>&1; then
  echo "Auto Applicator isn't installed yet: open Auto Applicator.app (it installs everything it needs)."
  exit 1
fi
exec uv run --project "$ROOT" --no-dev --quiet auto-applicator "$@"
