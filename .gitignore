# Personal runtime data (by default this lives in ~/Library/Application Support/AutoApplicator,
# but AA_HOME can point inside the repo during development)
data/
logs/
.aa-home/

# Build / tooling
.build/
.swiftpm/
dist/
build/
*.dmg
Auto Applicator.app/
.DS_Store

# Where your cloud browser lives (scripts/deploy_cloud.sh writes it; the build bundles it). Account-specific.
Resources/CloudConfig.json

# Never commit stray secrets dropped into the folder
*api_key*
*secret*
*.key
*.pem
*.p12

# Local agent prompt (describes features this project deliberately doesn't include)
AGENTS.md
