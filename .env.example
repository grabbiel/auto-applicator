# Auto Applicator secrets. The setup wizard writes your real copy to
# ~/Library/Application Support/AutoApplicator/.env (permissions 600).
# Never share that file.

# IMAP inbox used to read verification codes / links sent by job portals.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters, no spaces).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_APP_PASSWORD=your_16_char_app_password

# Password used when a portal (e.g. Workday) requires creating a candidate account.
# The wizard generates a strong random one for you.
ATS_DEFAULT_PASSWORD=StrongPortalPassword123!
